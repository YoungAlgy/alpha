{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha",
  "main": "src/worker-entry.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "everyday.report/*", "zone_name": "everyday.report" },
    { "pattern": "www.everyday.report/*", "zone_name": "everyday.report" },
    // alpha.everyday.report is the ACTUAL canonical hostname the app runs on
    // (see next.config.ts's redirects() comment: "the brand home is the
    // subdomain") -- missing this route meant direct visits here fell
    // through to the DNS wildcard's origin IP, still Vercel, entirely
    // bypassing this Worker.
    { "pattern": "alpha.everyday.report/*", "zone_name": "everyday.report" }
  ],
  // Defining routes disables the workers.dev preview URL by default -- keep
  // it on, it's the fastest way to verify a deploy before DNS even points here.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Without this, Cloudflare's asset layer resolves requests before the
    // Worker's fetch() handler runs -- confirmed as a real bug on both
    // toggletown (/universe) and baselens (homepage), same root cause each
    // time. Setting it here too even though alpha's own routes happened to
    // work without it, since that likely only held because alpha's static
    // output covers the routes tested so far, not a guarantee for every path.
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "alpha-inc-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "e032373a-f793-4a2f-81ee-cd6c825adf69",
      "database_name": "alpha-tag-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alpha"
    }
  ]
}
